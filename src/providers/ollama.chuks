// chuks_ai/providers/ollama — Ollama local model provider (Llama3, Mistral, Gemma, Phi, etc.)
// Ollama runs locally and uses an OpenAI-compatible API at localhost:11434
import { http } from "std/http"
import { json } from "std/json"
import { Channel } from "std/channel"
import { strings } from "std/strings"

// Chat-completion result. See `openai.chuks` for full field docs.
dataType CompletionResult {
    content: string;
    model: string;
    usage: any;
    finishReason: string;
    toolCalls: []any;
}

// Embedding-call result. See `openai.chuks` for full field docs.
dataType EmbeddingResult {
    embedding: []any;
    model: string;
    usage: any;
}

// ─── Ollama Client ─────────────────────────────────────────────

// Ollama client for locally-hosted models (Llama 3, Mistral, Gemma, Phi,
    // CodeLlama, …).
//
// Talks to a local Ollama daemon (default `http://localhost:11434`). No API
// key is required. Construct via `ai.ollama(model, config?)`.
//
// Config (all optional):
// - `baseUrl`      — override Ollama server URL
// - `temperature`  — default sampling temperature (default `0.8`)
// - `maxTokens`    — default max tokens per response (default `4096`)
// - `systemPrompt` — prepended on every conversation
class OllamaClient {
    private var _model: string = ""
    private var _baseUrl: string = "http://localhost:11434"
    private var _temperature: any = 0.8
    private var _maxTokens: int = 4096
    private var _systemPrompt: string = ""
    private var _tools: []any = []
    private var _toolHandlers: any = null
    private var _history: []any = []
    private var _historyEnabled: bool = false
    private var _maxHistory: int = 50

    constructor(model: string, config: any?) {
        this._model = model
        if (config != null) {
            if (config.baseUrl != null) { this._baseUrl = config.baseUrl }
            if (config.temperature != null) { this._temperature = config.temperature }
            if (config.maxTokens != null) { this._maxTokens = config.maxTokens }
            if (config.systemPrompt != null) { this._systemPrompt = config.systemPrompt }
        }
    }

    // ─── Configuration ──────────────────────────────────────────

    // Set the system prompt prepended to every request. Returns the client
    // for fluent chaining.
    public system(prompt: string): OllamaClient {
        this._systemPrompt = prompt
        return this
    }

    // Set the default sampling temperature. Returns the client for fluent
    // chaining. Override per call via `options.temperature`.
    public temperature(t: any): OllamaClient {
        this._temperature = t
        return this
    }

    // Set the default max tokens per response. Returns the client for fluent
    // chaining. Override per call via `options.maxTokens`.
    public maxTokens(n: int): OllamaClient {
        this._maxTokens = n
        return this
    }

    // Enable conversation memory: subsequent `complete`/`stream` calls send
    // every prior user+assistant turn back to the model.
    //
    // Args:
    // - `maxMessages` — cap on retained turn pairs (default `50`)
    //
    // Returns the client for fluent chaining.
    public enableHistory(maxMessages: int?): OllamaClient {
        this._historyEnabled = true
        if (maxMessages != null) {
            this._maxHistory = maxMessages
        }
        return this
    }

    // Wipe the in-memory conversation history.
    public clearHistory(): void {
        this._history = []
    }

    // ─── Tool Registration ──────────────────────────────────────

    // Register a tool the model may call via `completeWithTools`. Note:
    // many Ollama models don't natively support tool-calling — capability
    // depends on the specific model you've pulled.
    //
    // Args:
    // - `name`        — tool identifier
    // - `description` — natural-language hint
    // - `parameters`  — JSON Schema for the tool's args
    // - `handler`     — function `(args: any) -> any`
    //
    // Returns the client for fluent chaining.
    public registerTool(name: string, description: string, parameters: any, handler: any): OllamaClient {
        var tool: any = {
            "type": "function",
            "function": {
                "name": name,
                "description": description,
                "parameters": parameters,
            }
        }
        this._tools.push(tool)
        if (this._toolHandlers == null) {
            this._toolHandlers = {}
        }
        this._toolHandlers[name] = handler
        return this
    }

    // ─── Core: Complete ─────────────────────────────────────────

    // Single-shot chat completion against the local Ollama daemon.
    //
    // Args:
    // - `prompt`  — the user message
    // - `options` — optional overrides: `temperature`, `maxTokens`, `topP`,
    //               `stop`, `responseFormat`, `toolChoice`, or `messages`
    //               (override conversation entirely; used by chuks_agent).
    //
    // Returns a `CompletionResult`. On HTTP error returns an empty result
    // with `finishReason = "error"`.
    public async complete(prompt: string, options: any?): Task<CompletionResult> {
        // options.messages override — caller supplies a pre-built messages
        // array (e.g. chuks_agent driving a conversation with role:"tool").
        var messages: []any = []
        var usedOverride: bool = false
        if (options != null && options.messages != null) {
            messages = options.messages
            usedOverride = true
        } else {
            messages = this._buildMessages(prompt)
        }
        var body: any = {
            "model": this._model,
            "messages": messages,
            "stream": false,
            "options": {
                "temperature": this._temperature,
                "num_predict": this._maxTokens,
            }
        }
        if (this._tools.length > 0) {
            body["tools"] = this._tools
        }
        if (options != null) {
            if (options.temperature != null) { body["options"]["temperature"] = options.temperature }
            if (options.maxTokens != null) { body["options"]["num_predict"] = options.maxTokens }
        }

        var resp: any = await http.request("POST", 
            this._baseUrl + "/api/chat",
            json.stringify(body),
            { "Content-Type": "application/json" }
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            println("Ollama error: " + string(resp.status) + " — " + string(data.error))
            return { content: "", model: this._model, usage: null, finishReason: "error", toolCalls: [] }
        }

        var content: string = string(data.message.content)
        var toolCalls: []any = []
        if (data.message.tool_calls != null) {
            var i: int = 0
            while (i < data.message.tool_calls.length) {
                var tc: any = data.message.tool_calls[i]
                toolCalls.push({
                    id: string(i),
                    name: string(tc.function.name),
                    arguments: tc.function.arguments,
                })
                i = i + 1
            }
        }

        var result: CompletionResult = {
            content: content,
            model: string(data.model),
            usage: {
                "prompt_tokens": data.prompt_eval_count,
                "completion_tokens": data.eval_count,
                "total_duration": data.total_duration,
            },
            finishReason: string(data.done_reason),
            toolCalls: toolCalls,
        }

        if (this._historyEnabled && !usedOverride) {
            this._history.push({ "role": "user", "content": prompt })
            this._history.push({ "role": "assistant", "content": content })
            this._trimHistory()
        }

        return result
    }

    // ─── Core: Stream ───────────────────────────────────────────

    // Stream tokens from the model into a channel as they arrive.
    //
    // Args:
    // - `prompt`  — the user message
    // - `ch`      — `Channel<string>` that receives tokens; closed when done
    // - `options` — optional `temperature` / `maxTokens` overrides
    //
    // Returns the full concatenated assistant text.
    public async stream(prompt: string, ch: Channel<string>, options: any?): Task<any> {
        var messages: []any = this._buildMessages(prompt)
        var body: any = {
            "model": this._model,
            "messages": messages,
            "stream": true,
            "options": {
                "temperature": this._temperature,
                "num_predict": this._maxTokens,
            }
        }
        if (options != null) {
            if (options.temperature != null) { body["options"]["temperature"] = options.temperature }
            if (options.maxTokens != null) { body["options"]["num_predict"] = options.maxTokens }
        }

        var resp: any = await http.request("POST", 
            this._baseUrl + "/api/chat",
            json.stringify(body),
            { "Content-Type": "application/json" }
        )

        // Ollama streams as newline-delimited JSON (NDJSON)
        var fullContent: string = ""
        var lines: []string = strings.split(resp.body, "\n")
        var i: int = 0
        while (i < lines.length) {
            var line: string = strings.trim(lines[i])
            if (line != "") {
                var chunk: any = json.parse(line)
                if (chunk.message != null) {
                    if (chunk.message.content != null) {
                        var token: string = string(chunk.message.content)
                        if (token != "") {
                            fullContent = fullContent + token
                            ch.send(token)
                        }
                    }
                }
            }
            i = i + 1
        }
        ch.close()

        if (this._historyEnabled) {
            this._history.push({ "role": "user", "content": prompt })
            this._history.push({ "role": "assistant", "content": fullContent })
            this._trimHistory()
        }

        return fullContent
    }

    // ─── Core: Structured Output ────────────────────────────────

    // Force the model to emit JSON matching `schema` and return the parsed
    // object. The schema is appended to the prompt; results are `json.parse`d.
    //
    // Returns the parsed JSON, or `null` if parsing fails.
    public async structured(prompt: string, schema: any, options: any?): Task<any> {
        var schemaPrompt: string = prompt + "\n\nRespond ONLY with valid JSON matching this exact schema:\n" + json.stringify(schema)
        var body: any = {
            "model": this._model,
            "messages": this._buildMessages(schemaPrompt),
            "stream": false,
            "format": "json",
            "options": {
                "temperature": this._temperature,
                "num_predict": this._maxTokens,
            }
        }

        var resp: any = await http.request("POST", 
            this._baseUrl + "/api/chat",
            json.stringify(body),
            { "Content-Type": "application/json" }
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            println("Ollama error: " + string(resp.status))
            return null
        }

        var content: string = string(data.message.content)
        return json.parse(content)
    }

    // ─── Core: Embeddings ───────────────────────────────────────

    // Compute an embedding vector for a single string using a local embedding
    // model (must be pulled into Ollama first via `pull("nomic-embed-text")`).
    //
    // Args:
    // - `input` — text to embed
    // - `model` — embedding model id (default `"nomic-embed-text"`)
    //
    // Returns an `EmbeddingResult`; the vector lives at `.embedding`.
    public async embed(input: string, model: string?): Task<EmbeddingResult> {
        var embModel: string = this._model
        if (model != null) {
            embModel = model
        }
        var body: any = {
            "model": embModel,
            "input": input,
        }
        var resp: any = await http.request("POST", 
            this._baseUrl + "/api/embed",
            json.stringify(body),
            { "Content-Type": "application/json" }
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            println("Ollama Embeddings error: " + string(resp.status))
            return { embedding: [], model: embModel, usage: null }
        }
        return {
            embedding: data.embeddings[0],
            model: embModel,
            usage: null,
        }
    }

    // ─── Core: Tool Execution ───────────────────────────────────

    // Like `complete`, but auto-executes any tool calls the model requests
    // (looping with registered handlers) until it returns a final answer.
    //
    // Returns the final `CompletionResult`.
    public async completeWithTools(prompt: string, options: any?): Task<CompletionResult> {
        var result: CompletionResult = await this.complete(prompt, options)

        while (result.toolCalls.length > 0) {
            var toolMessages: []any = []
            var i: int = 0
            while (i < result.toolCalls.length) {
                var tc: any = result.toolCalls[i]
                var handler: any = this._toolHandlers[tc.name]
                if (handler != null) {
                    var toolResult: any = handler(tc.arguments)
                    toolMessages.push({
                        "role": "tool",
                        "content": string(toolResult),
                    })
                }
                i = i + 1
            }

            var messages: []any = this._buildMessages(prompt)
            messages.push({ "role": "assistant", "content": result.content, "tool_calls": result.toolCalls })
            var j: int = 0
            while (j < toolMessages.length) {
                messages.push(toolMessages[j])
                j = j + 1
            }

            var body: any = {
                "model": this._model,
                "messages": messages,
                "stream": false,
                "tools": this._tools,
                "options": { "temperature": this._temperature, "num_predict": this._maxTokens },
            }
            var resp: any = await http.request("POST", this._baseUrl + "/api/chat", json.stringify(body), { "Content-Type": "application/json" })
            var data: any = json.parse(resp.body)

            var content: string = string(data.message.content)
            var tcs: []any = []
            if (data.message.tool_calls != null) {
                var k: int = 0
                while (k < data.message.tool_calls.length) {
                    var tc2: any = data.message.tool_calls[k]
                    tcs.push({ id: string(k), name: string(tc2.function.name), arguments: tc2.function.arguments })
                    k = k + 1
                }
            }
            result = {
                content: content,
                model: string(data.model),
                usage: { "prompt_tokens": data.prompt_eval_count, "completion_tokens": data.eval_count },
                finishReason: string(data.done_reason),
                toolCalls: tcs,
            }
        }

        return result
    }

    // ─── Model Management ───────────────────────────────────────

    // List every model currently available on the local Ollama daemon
    // (calls `GET /api/tags`).
    //
    // Returns: `[]any` — each entry is the raw Ollama model descriptor
    // (`{ name, modified_at, size, digest, details }`).
    public async list(): Task<[]any> {
        var resp: any = await http.get(this._baseUrl + "/api/tags")
        var data: any = json.parse(resp.body)
        return data.models
    }

    // Download a model into the local Ollama daemon (calls `POST /api/pull`).
    //
    // Args:
    // - `modelName` — e.g. `"llama3"`, `"mistral"`, `"nomic-embed-text"`
    //
    // Returns the raw Ollama response object on success, or `null` on error.
    public async pull(modelName: string): Task<any> {
        var body: any = { "name": modelName, "stream": false }
        var resp: any = await http.request("POST", 
            this._baseUrl + "/api/pull",
            json.stringify(body),
            { "Content-Type": "application/json" }
        )
        return json.parse(resp.body)
    }

    // ─── Internals ──────────────────────────────────────────────

    private _buildMessages(prompt: string): []any {
        var messages: []any = []
        if (this._systemPrompt != "") {
            messages.push({ "role": "system", "content": this._systemPrompt })
        }
        if (this._historyEnabled) {
            var i: int = 0
            while (i < this._history.length) {
                messages.push(this._history[i])
                i = i + 1
            }
        }
        messages.push({ "role": "user", "content": prompt })
        return messages
    }

    private _trimHistory(): void {
        while (this._history.length > this._maxHistory * 2) {
            this._history.shift()
        }
    }
}

// ─── Factory ────────────────────────────────────────────────────

// Factory for `OllamaClient`. Prefer `ai.ollama(…)` from the unified facade;
// exported for direct/internal use.
function createOllama(model: string, config: any?): OllamaClient {
    return new OllamaClient(model, config)
}

export { OllamaClient, createOllama }
