// chuks_ai/providers/openai — OpenAI API provider (GPT-4o, GPT-4, GPT-3.5, o1, etc.)
import { http } from "std/http"
import { json } from "std/json"
import { Channel } from "std/channel"
import { strings } from "std/strings"
import { dotenv } from "std/dotenv"
import { withAttachments, openaiContent, openaiTranslateMessages } from "../media.chuks"

// ─── Request / Response types ────────────────────────────────────

// A single chat message in OpenAI's `messages` array format.
//
// Fields:
// - `role`    — `"system" | "user" | "assistant" | "tool"`
// - `content` — the message text (or tool-result string)
dataType ChatMessage {
    role: string;
    content: string;
}

// Description of a function/tool the model can call.
//
// Fields:
// - `name`        — unique identifier sent to the model
// - `description` — natural-language hint shown to the model
// - `parameters`  — JSON Schema object describing the function's args
dataType ToolDefinition {
    name: string;
    description: string;
    parameters: any;
}

// A tool invocation requested by the model.
//
// Fields:
// - `id`        — unique call id (echo back when sending the tool result)
// - `name`      — the tool the model wants to invoke
// - `arguments` — parsed arg object (already `json.parse`d for you)
dataType ToolCall {
    id: string;
    name: string;
    arguments: any;
}

// The result of a chat completion call.
//
// Fields:
// - `content`      — the assistant's text response (`""` if it called tools instead)
// - `model`        — the model id the server actually used
// - `usage`        — raw usage object: `{ prompt_tokens, completion_tokens, total_tokens }`
// - `finishReason` — `"stop" | "length" | "tool_calls" | "content_filter" | "error"`
// - `toolCalls`    — list of `ToolCall` the model requested (empty when none)
dataType CompletionResult {
    content: string;
    model: string;
    usage: any;
    finishReason: string;
    toolCalls: []any;
}

// The result of an embedding call.
//
// Fields:
// - `embedding` — the embedding vector as `[]float`
// - `model`     — the model id the server used
// - `usage`     — raw usage object (provider-shaped)
dataType EmbeddingResult {
    embedding: []any;
    model: string;
    usage: any;
}

// ─── OpenAI Client ──────────────────────────────────────────────

// OpenAI chat-completion client (GPT-4o, GPT-4, GPT-3.5-turbo, o1, o1-mini, …).
//
// Construct via `ai.openai(model, config?)` rather than `new OpenAIClient(…)`.
// The API key is taken from `config.apiKey` or, if absent, from the
// `OPENAI_API_KEY` environment variable (loaded via `dotenv`).
//
// Config (all optional):
// - `apiKey`        — OpenAI API key
// - `baseUrl`       — override base URL (default `https://api.openai.com/v1`)
// - `temperature`   — default sampling temperature (default `1.0`)
// - `maxTokens`     — default max tokens per response (default `4096`)
// - `systemPrompt`  — prepended on every conversation
class OpenAIClient {
    private var _apiKey: string = ""
    private var _model: string = ""
    private var _baseUrl: string = "https://api.openai.com/v1"
    private var _temperature: any = 1.0
    private var _maxTokens: int = 4096
    private var _systemPrompt: string = ""
    private var _tools: []any = []
    private var _toolHandlers: any = null
    private var _history: []any = []
    private var _historyEnabled: bool = false
    private var _maxHistory: int = 50

    constructor(model: string, config: any?) {
        this._model = model
        // Load API key from config or environment
        if (config != null) {
            if (config.apiKey != null) {
                this._apiKey = config.apiKey
            }
            if (config.baseUrl != null) {
                this._baseUrl = config.baseUrl
            }
            if (config.temperature != null) {
                this._temperature = config.temperature
            }
            if (config.maxTokens != null) {
                this._maxTokens = config.maxTokens
            }
            if (config.systemPrompt != null) {
                this._systemPrompt = config.systemPrompt
            }
        }
        if (this._apiKey == "") {
            try { dotenv.load() } catch (e) { }  // no .env is fine; leave key empty
            this._apiKey = dotenv.get("OPENAI_API_KEY", "")
        }
    }

    // ─── Configuration ──────────────────────────────────────────

    // Set the system prompt prepended to every request. Returns the client
    // for fluent chaining.
    public system(prompt: string): OpenAIClient {
        this._systemPrompt = prompt
        return this
    }

    // Set the default sampling temperature (`0.0`–`2.0`). Returns the client
    // for fluent chaining. Can be overridden per call via `options.temperature`.
    public temperature(t: any): OpenAIClient {
        this._temperature = t
        return this
    }

    // Set the default max tokens per response. Returns the client for fluent
    // chaining. Can be overridden per call via `options.maxTokens`.
    public maxTokens(n: int): OpenAIClient {
        this._maxTokens = n
        return this
    }

    // Enable conversation memory: subsequent `complete`/`stream` calls send
    // every prior user+assistant turn back to the model.
    //
    // Args:
    // - `maxMessages` — cap on retained turn pairs (default `50`)
    //
    // Returns the client for fluent chaining.
    public enableHistory(maxMessages: int?): OpenAIClient {
        this._historyEnabled = true
        if (maxMessages != null) {
            this._maxHistory = maxMessages
        }
        return this
    }

    // Wipe the in-memory conversation history.
    public clearHistory(): void {
        this._history = []
    }

    // ─── Tool Registration ──────────────────────────────────────

    // Register a function the model may call via `completeWithTools`.
    //
    // Args:
    // - `name`        — tool identifier sent to the model
    // - `description` — natural-language hint describing when/how to use it
    // - `parameters`  — JSON Schema for the tool's arguments
    // - `handler`     — function `(args: any) -> any` invoked when the model calls the tool
    //
    // Returns the client for fluent chaining.
    public registerTool(name: string, description: string, parameters: any, handler: any): OpenAIClient {
        var tool: any = {
            "type": "function",
            "function": {
                "name": name,
                "description": description,
                "parameters": parameters,
            }
        }
        this._tools.push(tool)
        if (this._toolHandlers == null) {
            this._toolHandlers = {}
        }
        this._toolHandlers[name] = handler
        return this
    }

    // ─── Core: Complete ─────────────────────────────────────────

    // Single-shot chat completion.
    //
    // Args:
    // - `prompt`  — the user message
    // - `options` — optional overrides. Recognised keys:
    //     - `temperature`, `maxTokens`, `topP`, `stop`
    //     - `responseFormat` — e.g. `{ type: "json_object" }`
    //     - `toolChoice`     — force a specific tool
    //     - `messages`       — supply a fully-built messages array (bypasses
        //                          history + systemPrompt; used by chuks_agent)
    //
    // Returns a `CompletionResult`. On HTTP error returns an empty result
    // with `finishReason = "error"`.
    public async complete(prompt: string, options: any?): Task<CompletionResult> {
        // options.messages override — caller supplies a pre-built messages
        // array (e.g. chuks_agent driving a conversation with role:"tool").
        var messages: []any = []
        var usedOverride: bool = false
        if (options != null && options.messages != null) {
            messages = openaiTranslateMessages(options.messages)
            usedOverride = true
        } else {
            messages = this._buildMessages(prompt, options)
        }
        var body: any = {
            "model": this._model,
            "messages": messages,
            "temperature": this._temperature,
            "max_tokens": this._maxTokens,
        }
        if (this._tools.length > 0) {
            body["tools"] = this._tools
        }
        if (options != null) {
            if (options.temperature != null) { body["temperature"] = options.temperature }
            if (options.maxTokens != null) { body["max_tokens"] = options.maxTokens }
            if (options.topP != null) { body["top_p"] = options.topP }
            if (options.stop != null) { body["stop"] = options.stop }
            if (options.responseFormat != null) { body["response_format"] = options.responseFormat }
            if (options.toolChoice != null) { body["tool_choice"] = options.toolChoice }
        }

        var resp: any = await http.request("POST", 
            this._baseUrl + "/chat/completions",
            json.stringify(body),
            this._headers()
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            var errMsg: string = "OpenAI API error: " + string(resp.status)
            if (data.error != null) {
                errMsg = errMsg + " — " + string(data.error.message)
            }
            println(errMsg)
            return { content: "", model: this._model, usage: null, finishReason: "error", toolCalls: [] }
        }

        var choice: any = data.choices[0]
        var result: CompletionResult = {
            content: string(choice.message.content),
            model: string(data.model),
            usage: data.usage,
            finishReason: string(choice.finish_reason),
            toolCalls: []
        }

        // Handle tool calls
        if (choice.message.tool_calls != null) {
            var toolCalls: []any = []
            var i: int = 0
            while (i < choice.message.tool_calls.length) {
                var tc: any = choice.message.tool_calls[i]
                toolCalls.push({
                    id: string(tc.id),
                    name: string(tc.function.name),
                    arguments: json.parse(string(tc.function.arguments)),
                })
                i = i + 1
            }
            result.toolCalls = toolCalls
        }

        // Store in history (skip when caller drives messages — they own state)
        if (this._historyEnabled && !usedOverride) {
            this._history.push({ "role": "user", "content": prompt })
            this._history.push({ "role": "assistant", "content": result.content })
            this._trimHistory()
        }

        return result
    }

    // ─── Core: Stream ───────────────────────────────────────────

    // Stream tokens from the model into a channel as they arrive.
    //
    // Args:
    // - `prompt`  — the user message
    // - `ch`      — a `Channel<string>` the caller receives tokens on; closed
    //               by this method when the response is complete
    // - `options` — optional `temperature` / `maxTokens` overrides
    //
    // Returns the full concatenated assistant text.
    // streamComplete is the real-streaming twin of complete(): opens the request
    // with `stream: true` and reads the OpenAI SSE incrementally via http.open,
    // invoking `onToken` for each content delta as it arrives. Returns the SAME
    // shape complete() does — { content, model, usage, finishReason, toolCalls }
    // — including tool calls reassembled from streamed argument fragments and
    // usage from the final chunk (requested via stream_options.include_usage).
    public async streamComplete(prompt: string, options: any?, onToken: function(string): void): Task<any> {
        var messages: []any = []
        if (options != null && options.messages != null) {
            messages = openaiTranslateMessages(options.messages)
        } else {
            messages = this._buildMessages(prompt, options)
        }
        var body: any = {
            "model": this._model,
            "messages": messages,
            "temperature": this._temperature,
            "max_tokens": this._maxTokens,
            "stream": true,
            "stream_options": { "include_usage": true },
        }
        if (this._tools.length > 0) { body["tools"] = this._tools }
        if (options != null) {
            if (options.temperature != null) { body["temperature"] = options.temperature }
            if (options.maxTokens != null) { body["max_tokens"] = options.maxTokens }
            if (options.topP != null) { body["top_p"] = options.topP }
            if (options.stop != null) { body["stop"] = options.stop }
            if (options.toolChoice != null) { body["tool_choice"] = options.toolChoice }
        }

        var stream: any = await http.open("POST",
            this._baseUrl + "/chat/completions",
            json.stringify(body),
            this._headers()
        )

        var content: string = ""
        // tool_calls stream fragmented: name arrives once, arguments in pieces,
        // grouped by array index. tcAcc[idx] = { id, name, args }.
        var tcAcc: []any = []
        var usage: any = null
        var finishReason: string = ""

        while (true) {
            var payload: string? = await stream.read()
            if (payload == null) { break }
            if (payload == "[DONE]") { continue }
            var chunk: any = json.parse(payload)
            if (chunk.usage != null) { usage = chunk.usage }
            if (chunk.choices == null || chunk.choices.length == 0) { continue }
            var choice: any = chunk.choices[0]
            if (choice.finish_reason != null) { finishReason = string(choice.finish_reason) }
            if (choice.delta == null) { continue }
            var delta: any = choice.delta
            if (delta.content != null) {
                var t: string = string(delta.content)
                content = content + t
                onToken(t)
            }
            if (delta.tool_calls != null) {
                var k: int = 0
                while (k < delta.tool_calls.length) {
                    var d: any = delta.tool_calls[k]
                    var idx: int = 0
                    if (d.index != null) { idx = int(d.index) }
                    while (tcAcc.length <= idx) { tcAcc.push({ "id": "", "name": "", "args": "" }) }
                    var acc: any = tcAcc[idx]
                    if (d.id != null) { acc["id"] = string(d.id) }
                    if (d.function != null) {
                        if (d.function.name != null) { acc["name"] = string(d.function.name) }
                        if (d.function.arguments != null) { acc["args"] = string(acc["args"]) + string(d.function.arguments) }
                    }
                    tcAcc[idx] = acc
                    k = k + 1
                }
            }
        }
        stream.close()

        var toolCalls: []any = []
        var ti: int = 0
        while (ti < tcAcc.length) {
            var a: any = tcAcc[ti]
            var argStr: string = string(a["args"])
            var args: any = {}
            if (argStr != "") { args = json.parse(argStr) }
            toolCalls.push({ id: string(a["id"]), name: string(a["name"]), arguments: args })
            ti = ti + 1
        }

        if (this._historyEnabled) {
            this._history.push({ "role": "user", "content": prompt })
            this._history.push({ "role": "assistant", "content": content })
            this._trimHistory()
        }

        return {
            "content": content,
            "model": this._model,
            "usage": usage,
            "finishReason": finishReason,
            "toolCalls": toolCalls,
        }
    }

    // Stream tokens into a channel as they arrive. Thin wrapper over
    // streamComplete; returns the full concatenated assistant text.
    public async stream(prompt: string, ch: Channel<string>, options: any?): Task<any> {
        var r: any = await this.streamComplete(prompt, options, function(t: string): void { ch.send(t) })
        ch.close()
        return string(r["content"])
    }

    // ─── Core: Structured Output ────────────────────────────────

    // Force the model to emit JSON matching `schema` and return the parsed
    // object.
    //
    // Args:
    // - `prompt`  — the user message; the schema is appended automatically
    // - `schema`  — a JSON-schema-shaped object describing the desired output
    // - `options` — reserved (currently unused)
    //
    // Returns the parsed JSON, or `null` on HTTP error.
    public async structured(prompt: string, schema: any, options: any?): Task<any> {
        var schemaPrompt: string = prompt + "\n\nRespond ONLY with valid JSON matching this exact schema:\n" + json.stringify(schema)
        var body: any = {
            "model": this._model,
            "messages": this._buildMessages(schemaPrompt, null),
            "temperature": this._temperature,
            "max_tokens": this._maxTokens,
            "response_format": { "type": "json_object" },
        }

        var resp: any = await http.request("POST", 
            this._baseUrl + "/chat/completions",
            json.stringify(body),
            this._headers()
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            println("OpenAI API error: " + string(resp.status))
            return null
        }

        var content: string = string(data.choices[0].message.content)
        return json.parse(content)
    }

    // ─── Core: Embeddings ───────────────────────────────────────

    // Compute an embedding vector for a single string.
    //
    // Args:
    // - `input` — text to embed
    // - `model` — embedding model id (default `"text-embedding-3-small"`)
    //
    // Returns an `EmbeddingResult`; the vector lives at `.embedding`.
    public async embed(input: string, model: string?): Task<EmbeddingResult> {
        var embModel: string = "text-embedding-3-small"
        if (model != null) {
            embModel = model
        }
        var body: map[string]string = {
            "model": embModel,
            "input": input,
        }
        var resp: any = await http.request("POST", 
            this._baseUrl + "/embeddings",
            json.stringify(body),
            this._headers()
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            println("OpenAI Embeddings error: " + string(resp.status))
            return { embedding: [], model: embModel, usage: null }
        }
        return {
            embedding: data.data[0].embedding,
            model: string(data.model),
            usage: data.usage,
        }
    }

    // Compute embeddings for many strings in one request.
    //
    // Args:
    // - `inputs` — array of texts
    // - `model`  — embedding model id (default `"text-embedding-3-small"`)
    //
    // Returns `[]any` where each element is the embedding vector for the
    // corresponding input.
    public async embedBatch(inputs: []string, model: string?): Task<[]any> {
        var embModel: string = "text-embedding-3-small"
        if (model != null) {
            embModel = model
        }
        var body: map[string]any = {
            "model": embModel,
            "input": inputs,
        }
        var resp: any = await http.request("POST", 
            this._baseUrl + "/embeddings",
            json.stringify(body),
            this._headers()
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            println("OpenAI Embeddings error: " + string(resp.status))
            return []
        }
        var results: []any = []
        var i: int = 0
        while (i < data.data.length) {
            results.push(data.data[i].embedding)
            i = i + 1
        }
        return results
    }

    // ─── Core: Tool Execution ───────────────────────────────────

    // Like `complete`, but if the model requests tool calls this method
    // executes the registered handlers and continues the conversation until
    // the model produces a final non-tool answer.
    //
    // Args:
    // - `prompt`  — the user message
    // - `options` — same shape as `complete()`
    //
    // Returns the final `CompletionResult` (with `finishReason ≠ "tool_calls"`).
    public async completeWithTools(prompt: string, options: any?): Task<CompletionResult> {
        var result: CompletionResult = await this.complete(prompt, options)

        // If the model called tools, execute them and continue
        while (result.finishReason == "tool_calls" || result.toolCalls.length > 0) {
            var toolMessages: []any = []
            var i: int = 0
            while (i < result.toolCalls.length) {
                var tc: any = result.toolCalls[i]
                var handler: any = this._toolHandlers[tc.name]
                if (handler != null) {
                    var toolResult: any = handler(tc.arguments)
                    toolMessages.push({
                        "role": "tool",
                        "tool_call_id": tc.id,
                        "content": string(toolResult),
                    })
                }
                i = i + 1
            }

            // Re-call with tool results
            var messages: []any = this._buildMessages(prompt, options)
            messages.push({
                "role": "assistant",
                "tool_calls": result.toolCalls,
            })
            var j: int = 0
            while (j < toolMessages.length) {
                messages.push(toolMessages[j])
                j = j + 1
            }

            var body: any = {
                "model": this._model,
                "messages": messages,
                "temperature": this._temperature,
                "max_tokens": this._maxTokens,
                "tools": this._tools,
            }
            var resp: any = await http.request("POST", 
                this._baseUrl + "/chat/completions",
                json.stringify(body),
                this._headers()
            )
            var data: any = json.parse(resp.body)
            var choice: any = data.choices[0]
            result = {
                content: string(choice.message.content),
                model: string(data.model),
                usage: data.usage,
                finishReason: string(choice.finish_reason),
                toolCalls: []
            }
            if (choice.message.tool_calls != null) {
                var tcs: []any = []
                var k: int = 0
                while (k < choice.message.tool_calls.length) {
                    var tc2: any = choice.message.tool_calls[k]
                    tcs.push({
                        id: string(tc2.id),
                        name: string(tc2.function.name),
                        arguments: json.parse(string(tc2.function.arguments)),
                    })
                    k = k + 1
                }
                result.toolCalls = tcs
            }
        }

        return result
    }

    // ─── Internals ──────────────────────────────────────────────

    private _headers(): any {
        return {
            "Content-Type": "application/json",
            "Authorization": "Bearer " + this._apiKey,
        }
    }

    private _buildMessages(prompt: string, options: any?): []any {
        var messages: []any = []
        if (this._systemPrompt != "") {
            messages.push({ "role": "system", "content": this._systemPrompt })
        }
        // Append conversation history
        if (this._historyEnabled) {
            var i: int = 0
            while (i < this._history.length) {
                messages.push(this._history[i])
                i = i + 1
            }
        }
        var content: any = withAttachments(prompt, options)
        messages.push({ "role": "user", "content": openaiContent(content) })
        return messages
    }

    private _trimHistory(): void {
        while (this._history.length > this._maxHistory * 2) {
            this._history.shift()
        }
    }
}

// ─── Factory ────────────────────────────────────────────────────

// Factory for `OpenAIClient`. Prefer the unified facade `ai.openai(…)` from
// `chuks_ai`; this is exported mainly for direct/internal use.
function createOpenAI(model: string, config: any?): OpenAIClient {
    return new OpenAIClient(model, config)
}

export { OpenAIClient, CompletionResult, EmbeddingResult, ChatMessage, ToolDefinition, ToolCall, createOpenAI }
