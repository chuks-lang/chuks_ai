// chuks_ai/providers/anthropic — Anthropic API provider (Claude 3.5, Claude 3, etc.)
import { http } from "std/http"
import { json } from "std/json"
import { Channel } from "std/channel"
import { strings } from "std/strings"
import { dotenv } from "std/dotenv"
import { isParts, withAttachments, anthropicContent } from "../media.chuks"

// Chat-completion result. See `openai.chuks` for full field docs.
dataType CompletionResult {
    content: string;
    model: string;
    usage: any;
    finishReason: string;
    toolCalls: []any;
}

// Embedding-call result. See `openai.chuks` for full field docs.
// (Anthropic does not currently host an embeddings API — reserved for parity.)
dataType EmbeddingResult {
    embedding: []any;
    model: string;
    usage: any;
}

// ─── Anthropic Client ───────────────────────────────────────────

// Anthropic Claude client (Claude 3.5 Sonnet, Claude 3 Opus/Haiku, …).
//
// Construct via `ai.anthropic(model, config?)`. The API key is taken from
// `config.apiKey` or the `ANTHROPIC_API_KEY` environment variable.
//
// Config (all optional):
// - `apiKey`       — Anthropic API key
// - `baseUrl`      — override base URL (default `https://api.anthropic.com/v1`)
// - `apiVersion`   — `anthropic-version` header (default `"2023-06-01"`)
// - `temperature`  — default sampling temperature (default `1.0`)
// - `maxTokens`    — default max tokens per response (default `4096`)
// - `systemPrompt` — sent in the dedicated `system` field on every request
class AnthropicClient {
    private var _apiKey: string = ""
    private var _model: string = ""
    private var _baseUrl: string = "https://api.anthropic.com/v1"
    private var _apiVersion: string = "2023-06-01"
    private var _temperature: any = 1.0
    private var _maxTokens: int = 4096
    private var _systemPrompt: string = ""
    private var _tools: []any = []
    private var _toolHandlers: any = null
    private var _history: []any = []
    private var _historyEnabled: bool = false
    private var _maxHistory: int = 50

    constructor(model: string, config: any?) {
        this._model = model
        if (config != null) {
            if (config.apiKey != null) { this._apiKey = config.apiKey }
            if (config.baseUrl != null) { this._baseUrl = config.baseUrl }
            if (config.temperature != null) { this._temperature = config.temperature }
            if (config.maxTokens != null) { this._maxTokens = config.maxTokens }
            if (config.systemPrompt != null) { this._systemPrompt = config.systemPrompt }
            if (config.apiVersion != null) { this._apiVersion = config.apiVersion }
        }
        if (this._apiKey == "") {
            try { dotenv.load() } catch (e) { }  // no .env is fine; leave key empty
            this._apiKey = dotenv.get("ANTHROPIC_API_KEY", "")
        }
    }

    // ─── Configuration ──────────────────────────────────────────

    // Set the system prompt sent in Anthropic's dedicated `system` field.
    // Returns the client for fluent chaining.
    public system(prompt: string): AnthropicClient {
        this._systemPrompt = prompt
        return this
    }

    // Set the default sampling temperature (`0.0`–`1.0`). Returns the client
    // for fluent chaining. Override per call via `options.temperature`.
    public temperature(t: any): AnthropicClient {
        this._temperature = t
        return this
    }

    // Set the default max tokens per response. Returns the client for fluent
    // chaining. Override per call via `options.maxTokens`.
    public maxTokens(n: int): AnthropicClient {
        this._maxTokens = n
        return this
    }

    // Enable conversation memory: subsequent `complete`/`stream` calls send
    // every prior user+assistant turn back to the model.
    //
    // Args:
    // - `maxMessages` — cap on retained turn pairs (default `50`)
    //
    // Returns the client for fluent chaining.
    public enableHistory(maxMessages: int?): AnthropicClient {
        this._historyEnabled = true
        if (maxMessages != null) {
            this._maxHistory = maxMessages
        }
        return this
    }

    // Wipe the in-memory conversation history.
    public clearHistory(): void {
        this._history = []
    }

    // ─── Tool Registration ──────────────────────────────────────

    // Register a tool the model may call via `completeWithTools`.
    //
    // Args:
    // - `name`        — tool identifier sent to Claude
    // - `description` — natural-language hint
    // - `parameters`  — JSON Schema (sent as Anthropic's `input_schema`)
    // - `handler`     — function `(args: any) -> any`
    //
    // Returns the client for fluent chaining.
    public registerTool(name: string, description: string, parameters: any, handler: any): AnthropicClient {
        var tool: any = {
            "name": name,
            "description": description,
            "input_schema": parameters,
        }
        this._tools.push(tool)
        if (this._toolHandlers == null) {
            this._toolHandlers = {}
        }
        this._toolHandlers[name] = handler
        return this
    }

    // ─── Core: Complete ─────────────────────────────────────────

    // Single-shot chat completion.
    //
    // Args:
    // - `prompt`  — the user message
    // - `options` — optional overrides: `temperature`, `maxTokens`, `topP`,
    //               `stop`, `toolChoice`, or `messages` (override conversation
        //               entirely; used by chuks_agent's tool-call loop).
    //
    // Returns a `CompletionResult`. On HTTP error returns an empty result
    // with `finishReason = "error"`.
    public async complete(prompt: string, options: any?): Task<CompletionResult> {
        // options.messages override — caller supplies pre-built messages
        // (used by chuks_agent's v2 tool-call loop)
        var messages: []any = []
        var sysOverride: string = ""
        if (options != null && options.messages != null) {
            var norm: any = this._normalizeMessages(options.messages)
            messages = norm["messages"]
            sysOverride = string(norm["system"])
        } else {
            messages = this._buildMessages(prompt, options)
        }
        var body: any = {
            "model": this._model,
            "messages": messages,
            "max_tokens": this._maxTokens,
            "temperature": this._temperature,
        }
        if (this._systemPrompt != "") {
            body["system"] = this._systemPrompt
        }
        // A system prompt carried in the messages array (chuks_agent) wins, since
        // it is the agent's actual instruction set.
        if (sysOverride != "") {
            body["system"] = sysOverride
        }
        if (this._tools.length > 0) {
            body["tools"] = this._tools
        }
        if (options != null) {
            if (options.temperature != null) { body["temperature"] = options.temperature }
            if (options.maxTokens != null) { body["max_tokens"] = options.maxTokens }
            if (options.topP != null) { body["top_p"] = options.topP }
            if (options.topK != null) { body["top_k"] = options.topK }
            if (options.stop != null) { body["stop_sequences"] = options.stop }
        }

        var resp: any = await http.request("POST", 
            this._baseUrl + "/messages",
            json.stringify(body),
            this._headers()
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            var errMsg: string = "Anthropic API error: " + string(resp.status)
            if (data.error != null) {
                errMsg = errMsg + " — " + string(data.error.message)
            }
            println(errMsg)
            return { content: "", model: this._model, usage: null, finishReason: "error", toolCalls: [] }
        }

        // Anthropic returns content as array of blocks
        var content: string = ""
        var toolCalls: []any = []
        var i: int = 0
        while (i < data.content.length) {
            var block: any = data.content[i]
            if (block.type == "text") {
                content = content + string(block.text)
            }
            if (block.type == "tool_use") {
                toolCalls.push({
                    id: string(block.id),
                    name: string(block.name),
                    arguments: block.input,
                })
            }
            i = i + 1
        }

        var result: CompletionResult = {
            content: content,
            model: string(data.model),
            usage: data.usage,
            finishReason: string(data.stop_reason),
            toolCalls: toolCalls,
        }

        if (this._historyEnabled) {
            this._history.push({ "role": "user", "content": prompt })
            this._history.push({ "role": "assistant", "content": content })
            this._trimHistory()
        }

        return result
    }

    // ─── Core: Stream ───────────────────────────────────────────

    // Stream tokens from Claude into a channel as they arrive.
    //
    // Args:
    // - `prompt`  — the user message
    // - `ch`      — `Channel<string>` that receives tokens; closed when done
    // - `options` — optional `temperature` / `maxTokens` overrides
    //
    // Returns the full concatenated assistant text.
    public async stream(prompt: string, ch: Channel<string>, options: any?): Task<any> {
        var messages: []any = this._buildMessages(prompt, options)
        var body: any = {
            "model": this._model,
            "messages": messages,
            "max_tokens": this._maxTokens,
            "temperature": this._temperature,
            "stream": true,
        }
        if (this._systemPrompt != "") {
            body["system"] = this._systemPrompt
        }
        if (options != null) {
            if (options.temperature != null) { body["temperature"] = options.temperature }
            if (options.maxTokens != null) { body["max_tokens"] = options.maxTokens }
        }

        var resp: any = await http.request("POST", 
            this._baseUrl + "/messages",
            json.stringify(body),
            this._headers()
        )

        // Parse SSE stream — Anthropic uses "event:" + "data:" pairs
        var fullContent: string = ""
        var lines: []string = strings.split(resp.body, "\n")
        var i: int = 0
        while (i < lines.length) {
            var line: string = strings.trim(lines[i])
            if (strings.startsWith(line, "data: ")) {
                var payload: string = strings.slice(line, 6, line.length)
                var chunk: any = json.parse(payload)
                if (chunk.type == "content_block_delta") {
                    if (chunk.delta != null) {
                        if (chunk.delta.text != null) {
                            var token: string = string(chunk.delta.text)
                            fullContent = fullContent + token
                            ch.send(token)
                        }
                    }
                }
            }
            i = i + 1
        }
        ch.close()

        if (this._historyEnabled) {
            this._history.push({ "role": "user", "content": prompt })
            this._history.push({ "role": "assistant", "content": fullContent })
            this._trimHistory()
        }

        return fullContent
    }

    // ─── Core: Structured Output ────────────────────────────────

    // Force the model to emit JSON matching `schema` and return the parsed
    // object.
    //
    // Claude does not have a native JSON-mode, so the schema is appended to
    // the prompt and the response is `json.parse`d on return.
    //
    // Returns the parsed JSON, or `null` if parsing fails.
    public async structured(prompt: string, schema: any, options: any?): Task<any> {
        var schemaPrompt: string = prompt + "\n\nRespond ONLY with valid JSON matching this exact schema:\n" + json.stringify(schema)
        var messages: []any = this._buildMessages(schemaPrompt, null)
        var body: any = {
            "model": this._model,
            "messages": messages,
            "max_tokens": this._maxTokens,
            "temperature": this._temperature,
        }
        if (this._systemPrompt != "") {
            body["system"] = this._systemPrompt
        }

        var resp: any = await http.request("POST", 
            this._baseUrl + "/messages",
            json.stringify(body),
            this._headers()
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            println("Anthropic API error: " + string(resp.status))
            return null
        }
        var content: string = ""
        var j: int = 0
        while (j < data.content.length) {
            if (data.content[j].type == "text") {
                content = content + string(data.content[j].text)
            }
            j = j + 1
        }
        return json.parse(content)
    }

    // ─── Core: Tool Execution ───────────────────────────────────

    // Like `complete`, but auto-executes any tool calls the model requests
    // (looping with registered handlers) until Claude returns a final answer.
    //
    // Returns the final `CompletionResult`.
    public async completeWithTools(prompt: string, options: any?): Task<CompletionResult> {
        var result: CompletionResult = await this.complete(prompt, options)

        while (result.finishReason == "tool_use" || result.toolCalls.length > 0) {
            var toolResults: []any = []
            var i: int = 0
            while (i < result.toolCalls.length) {
                var tc: any = result.toolCalls[i]
                var handler: any = this._toolHandlers[tc.name]
                if (handler != null) {
                    var toolResult: any = handler(tc.arguments)
                    toolResults.push({
                        "type": "tool_result",
                        "tool_use_id": tc.id,
                        "content": string(toolResult),
                    })
                }
                i = i + 1
            }

            // Continue conversation with tool results
            var messages: []any = this._buildMessages(prompt, options)
            messages.push({ "role": "assistant", "content": result.content })
            var k: int = 0
            while (k < toolResults.length) {
                messages.push({ "role": "user", "content": [toolResults[k]] })
                k = k + 1
            }

            var body: any = {
                "model": this._model,
                "messages": messages,
                "max_tokens": this._maxTokens,
                "temperature": this._temperature,
                "tools": this._tools,
            }
            if (this._systemPrompt != "") {
                body["system"] = this._systemPrompt
            }
            var resp: any = await http.request("POST", 
                this._baseUrl + "/messages",
                json.stringify(body),
                this._headers()
            )
            var data: any = json.parse(resp.body)
            var content: string = ""
            var tcs: []any = []
            var j: int = 0
            while (j < data.content.length) {
                var block: any = data.content[j]
                if (block.type == "text") { content = content + string(block.text) }
                if (block.type == "tool_use") {
                    tcs.push({ id: string(block.id), name: string(block.name), arguments: block.input })
                }
                j = j + 1
            }
            result = {
                content: content,
                model: string(data.model),
                usage: data.usage,
                finishReason: string(data.stop_reason),
                toolCalls: tcs,
            }
        }

        return result
    }

    // ─── Internals ──────────────────────────────────────────────

    private _headers(): any {
        return {
            "Content-Type": "application/json",
            "x-api-key": this._apiKey,
            "anthropic-version": this._apiVersion,
        }
    }

    // chuks_agent hands us OpenAI-shaped messages (roles system/user/assistant/
    // tool, carrying name/tool_calls/tool_call_id). Anthropic rejects those extra
    // keys and roles: the system prompt is a top-level field, an assistant's
    // tool_calls become `tool_use` content blocks, a tool result becomes a user
    // message with a `tool_result` block, and consecutive same-role turns must be
    // merged (roles have to alternate). Returns { system, messages } in Anthropic
    // form. Without this, `json.stringify` emits `"name":null` on every message
    // and the API 400s with "messages.0.name: Extra inputs are not permitted".
    private _normalizeMessages(raw: []any): any {
        var sys: string = ""
        var out: []any = []
        var i: int = 0
        while (i < raw.length) {
            var m: any = raw[i]
            var role: string = string(m.role)
            if (role == "system") {
                var sc: string = string(m.content)
                if (sc != "") {
                    if (sys != "") { sys = sys + "\n\n" }
                    sys = sys + sc
                }
                i = i + 1
                continue
            }
            if (role == "assistant") {
                var blocks: []any = []
                var c: string = string(m.content)
                if (c != "") { blocks.push({ "type": "text", "text": c }) }
                if (m.tool_calls != null) {
                    var t: int = 0
                    while (t < m.tool_calls.length) {
                        var tc: any = m.tool_calls[t]
                        blocks.push({
                            "type": "tool_use",
                            "id": string(tc.id),
                            "name": string(tc.name),
                            "input": tc.arguments,
                        })
                        t = t + 1
                    }
                }
                if (blocks.length > 0) {
                    if (out.length > 0 && string(out[out.length - 1]["role"]) == "assistant") {
                        var prev: any = out[out.length - 1]
                        var pc: []any = prev["content"]
                        var b: int = 0
                        while (b < blocks.length) { pc.push(blocks[b]); b = b + 1 }
                        prev["content"] = pc
                    } else {
                        out.push({ "role": "assistant", "content": blocks })
                    }
                }
                i = i + 1
                continue
            }
            // user or tool → a user turn built from content blocks. A user
            // message may carry multimodal parts (text + image/document), which
            // expand into multiple blocks.
            var newBlocks: []any = []
            if (role == "tool") {
                newBlocks.push({
                    "type": "tool_result",
                    "tool_use_id": string(m.tool_call_id),
                    "content": string(m.content),
                })
            } else if (isParts(m.content)) {
                var translated: any = anthropicContent(m.content)
                for (var tb of translated) { newBlocks.push(tb) }
            } else {
                newBlocks.push({ "type": "text", "text": string(m.content) })
            }
            if (out.length > 0 && string(out[out.length - 1]["role"]) == "user") {
                var pu: any = out[out.length - 1]
                var puc: []any = pu["content"]
                for (var nb of newBlocks) { puc.push(nb) }
                pu["content"] = puc
            } else {
                out.push({ "role": "user", "content": newBlocks })
            }
            i = i + 1
        }
        return { "system": sys, "messages": out }
    }

    private _buildMessages(prompt: string, options: any?): []any {
        var messages: []any = []
        if (this._historyEnabled) {
            var i: int = 0
            while (i < this._history.length) {
                messages.push(this._history[i])
                i = i + 1
            }
        }
        var content: any = withAttachments(prompt, options)
        messages.push({ "role": "user", "content": anthropicContent(content) })
        return messages
    }

    private _trimHistory(): void {
        while (this._history.length > this._maxHistory * 2) {
            this._history.shift()
        }
    }
}

// ─── Factory ────────────────────────────────────────────────────

// Factory for `AnthropicClient`. Prefer `ai.anthropic(…)` from the unified
// facade; exported for direct/internal use.
function createAnthropic(model: string, config: any?): AnthropicClient {
    return new AnthropicClient(model, config)
}

export { AnthropicClient, createAnthropic }
