// chuks_ai/providers/google — Google Gemini API provider (Gemini Pro, Gemini Flash, etc.)
import { http } from "std/http"
import { json } from "std/json"
import { Channel } from "std/channel"
import { strings } from "std/strings"
import { dotenv } from "std/dotenv"
import { isParts, withAttachments, geminiParts } from "../media.chuks"

// Chat-completion result. See `openai.chuks` for full field docs.
dataType CompletionResult {
    content: string;
    model: string;
    usage: any;
    finishReason: string;
    toolCalls: []any;
}

// Embedding-call result. See `openai.chuks` for full field docs.
dataType EmbeddingResult {
    embedding: []any;
    model: string;
    usage: any;
}

// ─── Google Gemini Client ───────────────────────────────────────

// Google Gemini client (`gemini-1.5-pro`, `gemini-1.5-flash`, `gemini-2.0-flash`, …).
//
// Construct via `ai.google(model, config?)`. The API key is taken from
// `config.apiKey` or the `GOOGLE_API_KEY` environment variable.
//
// Config (all optional):
// - `apiKey`       — Google Generative Language API key
// - `baseUrl`      — override base URL (default `https://generativelanguage.googleapis.com/v1beta`)
// - `temperature`  — default sampling temperature (default `1.0`)
// - `maxTokens`    — default max tokens per response (default `4096`)
// - `systemPrompt` — sent in Gemini's dedicated `systemInstruction` field
class GoogleClient {
    private var _apiKey: string = ""
    private var _model: string = ""
    private var _baseUrl: string = "https://generativelanguage.googleapis.com/v1beta"
    private var _temperature: any = 1.0
    private var _maxTokens: int = 4096
    private var _systemPrompt: string = ""
    private var _tools: []any = []
    private var _toolHandlers: any = null
    private var _history: []any = []
    private var _historyEnabled: bool = false
    private var _maxHistory: int = 50

    constructor(model: string, config: any?) {
        this._model = model
        if (config != null) {
            if (config.apiKey != null) { this._apiKey = config.apiKey }
            if (config.baseUrl != null) { this._baseUrl = config.baseUrl }
            if (config.temperature != null) { this._temperature = config.temperature }
            if (config.maxTokens != null) { this._maxTokens = config.maxTokens }
            if (config.systemPrompt != null) { this._systemPrompt = config.systemPrompt }
        }
        if (this._apiKey == "") {
            try { dotenv.load() } catch (e) { }  // no .env is fine; leave key empty
            this._apiKey = dotenv.get("GOOGLE_API_KEY", "")
        }
    }

    // ─── Configuration ──────────────────────────────────────────

    // Set the system prompt sent in Gemini's `systemInstruction` field.
    // Returns the client for fluent chaining.
    public system(prompt: string): GoogleClient {
        this._systemPrompt = prompt
        return this
    }

    // Set the default sampling temperature. Returns the client for fluent
    // chaining. Override per call via `options.temperature`.
    public temperature(t: any): GoogleClient {
        this._temperature = t
        return this
    }

    // Set the default max tokens per response. Returns the client for fluent
    // chaining. Override per call via `options.maxTokens`.
    public maxTokens(n: int): GoogleClient {
        this._maxTokens = n
        return this
    }

    // Enable conversation memory: subsequent `complete`/`stream` calls send
    // every prior user+model turn back to Gemini.
    //
    // Args:
    // - `maxMessages` — cap on retained turn pairs (default `50`)
    //
    // Returns the client for fluent chaining.
    public enableHistory(maxMessages: int?): GoogleClient {
        this._historyEnabled = true
        if (maxMessages != null) {
            this._maxHistory = maxMessages
        }
        return this
    }

    // Wipe the in-memory conversation history.
    public clearHistory(): void {
        this._history = []
    }

    // ─── Tool Registration ──────────────────────────────────────

    // Register a tool the model may call via `completeWithTools`.
    //
    // Args:
    // - `name`        — tool identifier
    // - `description` — natural-language hint
    // - `parameters`  — JSON Schema for the tool args (mapped to Gemini's
        //                    `functionDeclarations` shape internally)
    // - `handler`     — function `(args: any) -> any`
    //
    // Returns the client for fluent chaining.
    public registerTool(name: string, description: string, parameters: any, handler: any): GoogleClient {
        var tool: any = {
            "name": name,
            "description": description,
            "parameters": parameters,
        }
        this._tools.push(tool)
        if (this._toolHandlers == null) {
            this._toolHandlers = {}
        }
        this._toolHandlers[name] = handler
        return this
    }

    // ─── Core: Complete ─────────────────────────────────────────

    // Single-shot chat completion against Gemini.
    //
    // Args:
    // - `prompt`  — the user message
    // - `options` — optional overrides: `temperature`, `maxTokens`, `topP`,
    //               `stop`. Note: Gemini uses its own `contents` schema, so
    //               there is no `messages` override here (use the agent-side
        //               prompt construction instead).
    //
    // Returns a `CompletionResult`. On HTTP error returns an empty result
    // with `finishReason = "error"`.
    public async complete(prompt: string, options: any?): Task<CompletionResult> {
        var contents: []any = []
        var sysOverride: string = ""
        if (options != null && options.messages != null) {
            var norm: any = await this._normalizeContents(options.messages)
            contents = norm["contents"]
            sysOverride = string(norm["system"])
        } else {
            contents = await this._buildContents(prompt, options)
        }
        var body: any = {
            "contents": contents,
            "generationConfig": {
                "temperature": this._temperature,
                "maxOutputTokens": this._maxTokens,
            }
        }
        if (this._systemPrompt != "") {
            body["systemInstruction"] = {
                "parts": [{ "text": this._systemPrompt }],
            }
        }
        // A system prompt carried in the messages array (chuks_agent) wins.
        if (sysOverride != "") {
            body["systemInstruction"] = {
                "parts": [{ "text": sysOverride }],
            }
        }
        if (this._tools.length > 0) {
            var functionDecls: []any = []
            var i: int = 0
            while (i < this._tools.length) {
                functionDecls.push({
                    "name": this._tools[i].name,
                    "description": this._tools[i].description,
                    "parameters": this._tools[i].parameters,
                })
                i = i + 1
            }
            body["tools"] = [{ "functionDeclarations": functionDecls }]
        }
        if (options != null) {
            if (options.temperature != null) { body["generationConfig"]["temperature"] = options.temperature }
            if (options.maxTokens != null) { body["generationConfig"]["maxOutputTokens"] = options.maxTokens }
            if (options.topP != null) { body["generationConfig"]["topP"] = options.topP }
            if (options.topK != null) { body["generationConfig"]["topK"] = options.topK }
        }

        var endpoint: string = this._baseUrl + "/models/" + this._model + ":generateContent?key=" + this._apiKey
        var resp: any = await http.request("POST", 
            endpoint,
            json.stringify(body),
            { "Content-Type": "application/json" }
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            var errMsg: string = "Google API error: " + string(resp.status)
            if (data.error != null) {
                errMsg = errMsg + " — " + string(data.error.message)
            }
            println(errMsg)
            return { content: "", model: this._model, usage: null, finishReason: "error", toolCalls: [] }
        }

        var candidate: any = data.candidates[0]
        var content: string = ""
        var toolCalls: []any = []

        var j: int = 0
        while (j < candidate.content.parts.length) {
            var part: any = candidate.content.parts[j]
            if (part.text != null) {
                content = content + string(part.text)
            }
            if (part.functionCall != null) {
                toolCalls.push({
                    id: string(j),
                    name: string(part.functionCall.name),
                    arguments: part.functionCall.args,
                })
            }
            j = j + 1
        }

        var result: CompletionResult = {
            content: content,
            model: this._model,
            usage: data.usageMetadata,
            finishReason: string(candidate.finishReason),
            toolCalls: toolCalls,
        }

        if (this._historyEnabled) {
            this._history.push({ "role": "user", "parts": [{ "text": prompt }] })
            this._history.push({ "role": "model", "parts": [{ "text": content }] })
            this._trimHistory()
        }

        return result
    }

    // ─── Core: Stream ───────────────────────────────────────────

    // Stream tokens from Gemini into a channel as they arrive.
    //
    // Args:
    // - `prompt`  — the user message
    // - `ch`      — `Channel<string>` that receives tokens; closed when done
    // - `options` — optional `temperature` / `maxTokens` overrides
    //
    // Returns the full concatenated assistant text.
    public async stream(prompt: string, ch: Channel<string>, options: any?): Task<any> {
        var contents: []any = await this._buildContents(prompt, options)
        var body: any = {
            "contents": contents,
            "generationConfig": {
                "temperature": this._temperature,
                "maxOutputTokens": this._maxTokens,
            }
        }
        if (this._systemPrompt != "") {
            body["systemInstruction"] = {
                "parts": [{ "text": this._systemPrompt }],
            }
        }
        if (options != null) {
            if (options.temperature != null) { body["generationConfig"]["temperature"] = options.temperature }
            if (options.maxTokens != null) { body["generationConfig"]["maxOutputTokens"] = options.maxTokens }
        }

        var endpoint: string = this._baseUrl + "/models/" + this._model + ":streamGenerateContent?alt=sse&key=" + this._apiKey
        var resp: any = await http.request("POST", 
            endpoint,
            json.stringify(body),
            { "Content-Type": "application/json" }
        )

        var fullContent: string = ""
        var lines: []string = strings.split(resp.body, "\n")
        var i: int = 0
        while (i < lines.length) {
            var line: string = strings.trim(lines[i])
            if (strings.startsWith(line, "data: ")) {
                var payload: string = strings.slice(line, 6, line.length)
                var chunk: any = json.parse(payload)
                if (chunk.candidates != null) {
                    if (chunk.candidates[0].content != null) {
                        var parts: any = chunk.candidates[0].content.parts
                        var j: int = 0
                        while (j < parts.length) {
                            if (parts[j].text != null) {
                                var token: string = string(parts[j].text)
                                fullContent = fullContent + token
                                ch.send(token)
                            }
                            j = j + 1
                        }
                    }
                }
            }
            i = i + 1
        }
        ch.close()

        if (this._historyEnabled) {
            this._history.push({ "role": "user", "parts": [{ "text": prompt }] })
            this._history.push({ "role": "model", "parts": [{ "text": fullContent }] })
            this._trimHistory()
        }

        return fullContent
    }

    // ─── Core: Structured Output ────────────────────────────────

    // Force the model to emit JSON matching `schema` and return the parsed
    // object. Uses Gemini's native `responseMimeType: "application/json"`.
    //
    // Returns the parsed JSON, or `null` on HTTP error.
    public async structured(prompt: string, schema: any, options: any?): Task<any> {
        var schemaPrompt: string = prompt + "\n\nRespond ONLY with valid JSON matching this exact schema:\n" + json.stringify(schema)
        var schemaContents: []any = await this._buildContents(schemaPrompt, null)
        var body: any = {
            "contents": schemaContents,
            "generationConfig": {
                "temperature": this._temperature,
                "maxOutputTokens": this._maxTokens,
                "responseMimeType": "application/json",
            }
        }
        if (this._systemPrompt != "") {
            body["systemInstruction"] = {
                "parts": [{ "text": this._systemPrompt }],
            }
        }

        var endpoint: string = this._baseUrl + "/models/" + this._model + ":generateContent?key=" + this._apiKey
        var resp: any = await http.request("POST", 
            endpoint,
            json.stringify(body),
            { "Content-Type": "application/json" }
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            println("Google API error: " + string(resp.status))
            return null
        }

        var content: string = ""
        var k: int = 0
        while (k < data.candidates[0].content.parts.length) {
            if (data.candidates[0].content.parts[k].text != null) {
                content = content + string(data.candidates[0].content.parts[k].text)
            }
            k = k + 1
        }
        return json.parse(content)
    }

    // ─── Core: Embeddings ───────────────────────────────────────

    // Compute an embedding vector for a single string.
    //
    // Args:
    // - `input` — text to embed
    // - `model` — embedding model id (default `"text-embedding-004"`)
    //
    // Returns an `EmbeddingResult`; the vector lives at `.embedding`.
    public async embed(input: string, model: string?): Task<EmbeddingResult> {
        var embModel: string = "text-embedding-004"
        if (model != null) {
            embModel = model
        }
        var body: any = {
            "model": "models/" + embModel,
            "content": {
                "parts": [{ "text": input }],
            }
        }
        var endpoint: string = this._baseUrl + "/models/" + embModel + ":embedContent?key=" + this._apiKey
        var resp: any = await http.request("POST", 
            endpoint,
            json.stringify(body),
            { "Content-Type": "application/json" }
        )
        var data: any = json.parse(resp.body)
        if (resp.status != 200) {
            println("Google Embeddings error: " + string(resp.status))
            return { embedding: [], model: embModel, usage: null }
        }
        return {
            embedding: data.embedding.values,
            model: embModel,
            usage: null,
        }
    }

    // ─── Core: Tool Execution ───────────────────────────────────

    // Like `complete`, but auto-executes any tool calls Gemini requests
    // (looping with registered handlers) until it returns a final answer.
    //
    // Returns the final `CompletionResult`.
    public async completeWithTools(prompt: string, options: any?): Task<CompletionResult> {
        var result: CompletionResult = await this.complete(prompt, options)

        while (result.toolCalls.length > 0) {
            var functionResponses: []any = []
            var i: int = 0
            while (i < result.toolCalls.length) {
                var tc: any = result.toolCalls[i]
                var handler: any = this._toolHandlers[tc.name]
                if (handler != null) {
                    var toolResult: any = handler(tc.arguments)
                    functionResponses.push({
                        "functionResponse": {
                            "name": tc.name,
                            "response": { "result": toolResult },
                        }
                    })
                }
                i = i + 1
            }

            var contents: []any = await this._buildContents(prompt, options)
            contents.push({
                "role": "model",
                "parts": result.toolCalls,
            })
            contents.push({
                "role": "function",
                "parts": functionResponses,
            })

            var body: any = {
                "contents": contents,
                "generationConfig": {
                    "temperature": this._temperature,
                    "maxOutputTokens": this._maxTokens,
                }
            }
            if (this._systemPrompt != "") {
                body["systemInstruction"] = { "parts": [{ "text": this._systemPrompt }] }
            }
            if (this._tools.length > 0) {
                var functionDecls: []any = []
                var k: int = 0
                while (k < this._tools.length) {
                    functionDecls.push({
                        "name": this._tools[k].name,
                        "description": this._tools[k].description,
                        "parameters": this._tools[k].parameters,
                    })
                    k = k + 1
                }
                body["tools"] = [{ "functionDeclarations": functionDecls }]
            }

            var endpoint: string = this._baseUrl + "/models/" + this._model + ":generateContent?key=" + this._apiKey
            var resp: any = await http.request("POST", endpoint, json.stringify(body), { "Content-Type": "application/json" })
            var data: any = json.parse(resp.body)

            var candidate: any = data.candidates[0]
            var content: string = ""
            var tcs: []any = []
            var j: int = 0
            while (j < candidate.content.parts.length) {
                var part: any = candidate.content.parts[j]
                if (part.text != null) { content = content + string(part.text) }
                if (part.functionCall != null) {
                    tcs.push({ id: string(j), name: string(part.functionCall.name), arguments: part.functionCall.args })
                }
                j = j + 1
            }
            result = {
                content: content,
                model: this._model,
                usage: data.usageMetadata,
                finishReason: string(candidate.finishReason),
                toolCalls: tcs,
            }
        }

        return result
    }

    // ─── Internals ──────────────────────────────────────────────

    // chuks_agent hands us OpenAI-shaped messages (roles system/user/assistant/
    // tool, carrying name/tool_calls/tool_call_id). Gemini uses an entirely
    // different schema: a `contents` array of { role: "user"|"model", parts:[...] }
    // with `functionCall` / `functionResponse` parts, and the system prompt as a
    // top-level `systemInstruction`. Assistant tool_calls become functionCall
    // parts; tool results become a user turn with a functionResponse part; and
    // consecutive same-role turns are merged. Returns { system, contents }.
    private async _normalizeContents(raw: []any): Task<any> {
        var sys: string = ""
        var out: []any = []
        var i: int = 0
        while (i < raw.length) {
            var m: any = raw[i]
            var role: string = string(m.role)
            if (role == "system") {
                var sc: string = string(m.content)
                if (sc != "") {
                    if (sys != "") { sys = sys + "\n\n" }
                    sys = sys + sc
                }
                i = i + 1
                continue
            }
            var gRole: string = "user"
            var parts: []any = []
            if (role == "assistant") {
                gRole = "model"
                var c: string = string(m.content)
                if (c != "") { parts.push({ "text": c }) }
                if (m.tool_calls != null) {
                    var t: int = 0
                    while (t < m.tool_calls.length) {
                        var tc: any = m.tool_calls[t]
                        parts.push({
                            "functionCall": {
                                "name": string(tc.name),
                                "args": tc.arguments,
                            },
                        })
                        t = t + 1
                    }
                }
            } else if (role == "tool") {
                parts.push({
                    "functionResponse": {
                        "name": string(m.name),
                        "response": { "result": string(m.content) },
                    },
                })
            } else if (isParts(m.content)) {
                var gp: []any = await geminiParts(m.content)
                for (var g of gp) { parts.push(g) }
            } else {
                parts.push({ "text": string(m.content) })
            }
            if (parts.length == 0) { i = i + 1; continue }
            if (out.length > 0 && string(out[out.length - 1]["role"]) == gRole) {
                var prev: any = out[out.length - 1]
                var pp: []any = prev["parts"]
                var b: int = 0
                while (b < parts.length) { pp.push(parts[b]); b = b + 1 }
                prev["parts"] = pp
            } else {
                out.push({ "role": gRole, "parts": parts })
            }
            i = i + 1
        }
        return { "system": sys, "contents": out }
    }

    private async _buildContents(prompt: string, options: any?): Task<[]any> {
        var contents: []any = []
        if (this._historyEnabled) {
            var i: int = 0
            while (i < this._history.length) {
                contents.push(this._history[i])
                i = i + 1
            }
        }
        var content: any = withAttachments(prompt, options)
        contents.push({
            "role": "user",
            "parts": await geminiParts(content),
        })
        return contents
    }

    private _trimHistory(): void {
        while (this._history.length > this._maxHistory * 2) {
            this._history.shift()
        }
    }
}

// ─── Factory ────────────────────────────────────────────────────

// Factory for `GoogleClient`. Prefer `ai.google(…)` from the unified facade;
// exported for direct/internal use.
function createGoogle(model: string, config: any?): GoogleClient {
    return new GoogleClient(model, config)
}

export { GoogleClient, createGoogle }
